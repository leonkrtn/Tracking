# Vorlage für .env.local (wird nicht eingecheckt).
#
# Nur nötig, wenn ein anderes Supabase-Projekt als das im Code
# hinterlegte verwendet werden soll – z. B. beim Umzug in einen anderen
# Account (siehe supabase/UMZUG.md).
#
# Beim Hoster (Vercel / Netlify) dieselben zwei Variablen setzen und neu
# deployen; dann ist keine Code-Änderung nötig.
#
# Werte stehen in Supabase unter: Project Settings → API
# Der publishable/anon Key ist öffentlich – der Schutz kommt aus den
# RLS-Policies in der Datenbank.

VITE_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
